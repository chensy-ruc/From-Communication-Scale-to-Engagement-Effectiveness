# YouTube Data API v3 key. Leave blank for offline CSV reproduction.
YOUTUBE_API_KEY=

# Separate credentials for an OpenAI-compatible Chat Completions provider.
# Set a base URL (without /chat/completions) and an available model ID.
# Check response_format, token_limit_field and thinking in config.toml for your provider.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# AI_CODER_MODEL=

# Optional: set only if you actually use a working local HTTP proxy.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
